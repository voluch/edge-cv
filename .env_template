# Copy to .env and fill in. .env is git-ignored and protected from edits by Claude (see .claude/hooks/protect-env.sh).
# Never commit real values.

# --- Raspberry Pi ---
PI_HOST=pi@ecv-pi

# --- Experiment tracking (use one) ---
WANDB_API_KEY=
WANDB_PROJECT=edge-cv
MLFLOW_TRACKING_URI=

# --- DVC private remote (example: S3-compatible bucket) ---
DVC_REMOTE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Cloud GPU (RunPod) ---
RUNPOD_API_KEY=

# --- Labelling ---
CVAT_URL=
CVAT_TOKEN=

# --- Alerts (T3) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Teacher model APIs for auto-labelling (optional) ---
HF_TOKEN=
