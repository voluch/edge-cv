{
  "permissions": {
    "allow": [
      "Bash(make setup)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make -C * test)",
      "Bash(make -C * lint)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(dvc pull*)",
      "Bash(ssh pi@ecv-pi uptime)"
